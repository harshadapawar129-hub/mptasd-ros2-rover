<?xml version="1.0"?>

<robot name="mptasd_rover_gazebo"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- PARAMETERS -->
  <!-- ========================================================= -->

  <xacro:property name="base_mass" value="1.0"/>
  <xacro:property name="rocker_mass" value="0.25"/>
  <xacro:property name="bogie_mass" value="0.20"/>
  <xacro:property name="wheel_mass" value="0.125"/>

  <!-- Rover body -->
  <xacro:property name="body_length" value="0.555"/>
  <xacro:property name="body_width" value="0.435"/>
  <xacro:property name="body_height" value="0.10"/>

  <!-- Wheel -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>

  <!-- ========================================================= -->
  <!-- MATERIALS -->
  <!-- ========================================================= -->

  <material name="body_material">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <material name="suspension_material">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="wheel_material">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>

  <!-- ========================================================= -->
  <!-- BASE LINK -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_material"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="0.0199"
        ixy="0"
        ixz="0"
        iyy="0.0318"
        iyz="0"
        izz="0.0500"/>
    </inertial>

  </link>

  <!-- Base footprint to base -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- LEFT ROCKER -->
  <!-- ========================================================= -->

  <link name="rocker_left">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.05 0.05"/>
      </geometry>
      <material name="suspension_material"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.05 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${rocker_mass}"/>
      <inertia
        ixx="0.0005"
        ixy="0"
        ixz="0"
        iyy="0.0015"
        iyz="0"
        izz="0.0015"/>
    </inertial>

  </link>

  <joint name="rocker_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rocker_left"/>
    <origin xyz="0 0.235 -0.07" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.7" upper="0.7" effort="50" velocity="1.0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- RIGHT ROCKER -->
  <!-- ========================================================= -->

  <link name="rocker_right">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.05 0.05"/>
      </geometry>
      <material name="suspension_material"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.05 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${rocker_mass}"/>
      <inertia
        ixx="0.0005"
        ixy="0"
        ixz="0"
        iyy="0.0015"
        iyz="0"
        izz="0.0015"/>
    </inertial>

  </link>

  <joint name="rocker_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rocker_right"/>
    <origin xyz="0 -0.235 -0.07" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.7" upper="0.7" effort="50" velocity="1.0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- LEFT BOGIE -->
  <!-- ========================================================= -->

  <link name="bogie_left">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.05 0.05"/>
      </geometry>
      <material name="suspension_material"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.05 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${bogie_mass}"/>
      <inertia
        ixx="0.0003"
        ixy="0"
        ixz="0"
        iyy="0.0010"
        iyz="0"
        izz="0.0010"/>
    </inertial>

  </link>

  <joint name="bogie_left_joint" type="revolute">
    <parent link="rocker_left"/>
    <child link="bogie_left"/>
    <origin xyz="-0.08 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.7" upper="0.7" effort="30" velocity="1.0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- RIGHT BOGIE -->
  <!-- ========================================================= -->

  <link name="bogie_right">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.05 0.05"/>
      </geometry>
      <material name="suspension_material"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.05 0.05"/>
      </geometry>
      <material name="suspension_material"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${bogie_mass}"/>
      <inertia
        ixx="0.0003"
        ixy="0"
        ixz="0"
        iyy="0.0010"
        iyz="0"
        izz="0.0010"/>
    </inertial>

  </link>

  <joint name="bogie_right_joint" type="revolute">
    <parent link="rocker_right"/>
    <child link="bogie_right"/>
    <origin xyz="-0.08 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.7" upper="0.7" effort="30" velocity="1.0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- WHEEL MACRO -->
  <!-- ========================================================= -->

  <xacro:macro name="wheel" params="name parent x">

    <link name="${name}">

      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
        <material name="wheel_material"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="0.000156"
          ixy="0"
          ixz="0"
          iyy="0.000091"
          iyz="0"
          izz="0.000091"/>
      </inertial>

    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

  <!-- ========================================================= -->
  <!-- SIX WHEELS -->
  <!-- ========================================================= -->

  <!-- Left -->
  <xacro:wheel
    name="front_left_wheel"
    parent="rocker_left"
    x="0.21"/>

  <xacro:wheel
    name="middle_left_wheel"
    parent="bogie_left"
    x="0.08"/>

  <xacro:wheel
    name="rear_left_wheel"
    parent="bogie_left"
    x="-0.15"/>

  <!-- Right -->
  <xacro:wheel
    name="front_right_wheel"
    parent="rocker_right"
    x="0.21"/>

  <xacro:wheel
    name="middle_right_wheel"
    parent="bogie_right"
    x="0.08"/>

  <xacro:wheel
    name="rear_right_wheel"
    parent="bogie_right"
    x="-0.15"/>
  <!-- ==================== LiDAR ==================== -->

  <link name="lidar_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
    <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>

      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  
</robot>

